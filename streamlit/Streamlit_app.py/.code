# ============================================================
# PAGE CONFIG
# ============================================================

st.set_page_config(
    page_title="Snowflake FinOps Control Center",
    page_icon="❄️",
    layout="wide",
    initial_sidebar_state="expanded",
)


# ============================================================
# GLOBAL DESIGN SYSTEM
# ============================================================

st.markdown(
    """
    <style>

    /* ========================================================
       GLOBAL
       ======================================================== */

    .stApp {
        background: #F7F9FC;
    }

    .main .block-container {
        max-width: 1480px;
