# ============================================================
# NAVIGATION
# ============================================================

overview = st.Page(
    "app_pages/1_Overview.py",
    title="Overview",
    icon=":material/dashboard:",
)

warehouses = st.Page(
    "app_pages/2_Warehouses.py",
    title="Warehouses",
