        letter-spacing: -0.02em;
    }

    .finops-brand-subtitle {
        color: #98A2B3;
        font-size: 0.72rem;
        margin-top: 2px;
        letter-spacing: 0.07em;
        text-transform: uppercase;
    }


    /* ========================================================
       SIDEBAR ENVIRONMENT
       ======================================================== */

    .environment-card {
        background: #1D2939;
        border: 1px solid #344054;
        border-radius: 12px;
