        margin-top: 5px;
    }

    .environment-db {
        color: #98A2B3;
        font-size: 0.70rem;
        margin-top: 3px;
    }


    /* ========================================================
       SIDEBAR FOOTER
       ======================================================== */

    .sidebar-footer {
        color: #98A2B3;
        font-size: 0.68rem;
        line-height: 1.55;
        margin-top: 18px;
    }


    /* ========================================================
       KPI CARDS
       ======================================================== */

    [data-testid="stMetric"] {
        background: #FFFFFF;
        border: 1px solid #EAECF0;
        border-radius: 14px;
        padding: 18px 20px;
        min-height: 108px;
        box-shadow: 0 1px 3px rgba(16, 24, 40, 0.04);
    }

    [data-testid="stMetricLabel"] {
        color: #667085 !important;
        font-size: 0.82rem !important;
        font-weight: 550 !important;
    }

    [data-testid="stMetricValue"] {
        color: #101828 !important;
        font-size: 1.75rem !important;
        font-weight: 750 !important;
    }


    /* ========================================================
       DATAFRAMES
       ======================================================== */

    [data-testid="stDataFrame"] {
        background: #FFFFFF;
        border: 1px solid #EAECF0;
        border-radius: 12px;
        overflow: hidden;
    }


    /* ========================================================
       SELECT BOXES
       ======================================================== */

    div[data-baseweb="select"] > div {
        background: #FFFFFF;
        border-color: #D0D5DD;
        border-radius: 9px;
    }


    /* ========================================================
       BUTTONS
       ======================================================== */

    .stButton > button {
