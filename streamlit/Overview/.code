import streamlit as st
import pandas as pd
from snowflake.snowpark.context import get_active_session

session = get_active_session()


# ============================================================
# HELPERS
# ============================================================

def run_query(sql):
    return session.sql(sql).to_pandas()


def money(value):
    return f"${float(value):,.2f}"


def credits(value):
    return f"{float(value):,.4f}"


def pct(value):
    return f"{float(value):,.1f}%"


# ============================================================
# PAGE STYLE
# ============================================================

st.html("""
<style>

.main .block-container {
    padding-top: 2rem;
    padding-bottom: 3rem;
    max-width: 1400px;
}

/* HERO */

.finops-hero {
    background: linear-gradient(
        135deg,
        #101828 0%,
        #173B7A 48%,
        #175CD3 100%
    );

    border-radius: 18px;
    padding: 34px 36px;
    margin-bottom: 22px;

    box-shadow:
        0 8px 24px rgba(16, 24, 40, 0.12);
}

.hero-label {
    color: #53B1FD;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    margin-bottom: 8px;
}

.hero-title {
    color: #FFFFFF;
    font-size: 2.15rem;
    font-weight: 800;
    letter-spacing: -0.035em;
    margin-bottom: 8px;
}

.hero-description {
    color: #D1E9FF;
    font-size: 0.95rem;
    line-height: 1.5;
    max-width: 900px;
}

