import streamlit as st
import pandas as pd
import numpy as np
from snowflake.snowpark.context import get_active_session

session = get_active_session()


# ============================================================
# HELPERS
# ============================================================

def run_query(sql):
    return session.sql(sql).to_pandas()


def money(value):
    value = float(value or 0)
    return f"${value:,.2f}"


def credits(value):
    value = float(value or 0)
    return f"{value:,.4f}"


def percentage(value):
    value = float(value or 0)
    return f"{value:.1f}%"


# ============================================================
# PAGE STYLE
# ============================================================

st.html("""
<style>

.main .block-container {
    padding-top: 2rem;
    padding-bottom: 3rem;
    max-width: 1400px;
}

/* HERO */

.anomaly-hero {
    background: linear-gradient(
        135deg,
        #101828 0%,
        #173B7A 48%,
        #175CD3 100%
    );

    border-radius: 18px;
