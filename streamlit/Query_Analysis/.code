# ============================================================
# LOAD REAL QUERY TELEMETRY
# ============================================================

query_df = run_query("""
SELECT
    QUERY_ID,
    QUERY_TEXT,
    WAREHOUSE_NAME,
    QUERY_TYPE,
    EXECUTION_STATUS,
    START_TIME,
    TOTAL_ELAPSED_TIME,
    EXECUTION_TIME,
    COMPILATION_TIME,
    QUEUED_PROVISIONING_TIME,
    QUEUED_OVERLOAD_TIME,
    TRANSACTION_BLOCKED_TIME,
    BYTES_SCANNED,
    PERCENTAGE_SCANNED_FROM_CACHE,
    PARTITIONS_SCANNED,
    PARTITIONS_TOTAL,
    BYTES_SPILLED_TO_LOCAL_STORAGE,
    BYTES_SPILLED_TO_REMOTE_STORAGE,
    ROWS_PRODUCED,
    QUERY_PARAMETERIZED_HASH
FROM SNOWFLAKE_FINOPS.RAW.QUERY_HISTORY_RAW
WHERE START_TIME IS NOT NULL
ORDER BY START_TIME DESC
LIMIT 1000
""")


# ============================================================
# CLEAN DATA
# ============================================================

if not query_df.empty:

    query_df["START_TIME"] = pd.to_datetime(
        query_df["START_TIME"],
        errors="coerce"
    )

    numeric_columns = [
        "TOTAL_ELAPSED_TIME",
        "EXECUTION_TIME",
        "COMPILATION_TIME",
        "QUEUED_PROVISIONING_TIME",
        "QUEUED_OVERLOAD_TIME",
        "TRANSACTION_BLOCKED_TIME",
        "BYTES_SCANNED",
        "PERCENTAGE_SCANNED_FROM_CACHE",
        "PARTITIONS_SCANNED",
        "PARTITIONS_TOTAL",
        "BYTES_SPILLED_TO_LOCAL_STORAGE",
        "BYTES_SPILLED_TO_REMOTE_STORAGE",
        "ROWS_PRODUCED",
    ]

    for col in numeric_columns:
        query_df[col] = pd.to_numeric(
            query_df[col],
            errors="coerce"
        ).fillna(0)

    query_df["PARTITION_SCAN_PCT"] = 0.0

    valid_partition_rows = (
        query_df["PARTITIONS_TOTAL"] > 0
    )

    query_df.loc[
        valid_partition_rows,
        "PARTITION_SCAN_PCT"
    ] = (
        query_df.loc[
            valid_partition_rows,
            "PARTITIONS_SCANNED"
        ]
        /
        query_df.loc[
            valid_partition_rows,
            "PARTITIONS_TOTAL"
        ]
        * 100
    )

    query_df["TOTAL_SPILL_BYTES"] = (
        query_df["BYTES_SPILLED_TO_LOCAL_STORAGE"]
        +
        query_df["BYTES_SPILLED_TO_REMOTE_STORAGE"]
    )

    query_df["STATUS"] = (
        query_df["EXECUTION_STATUS"]
        .astype(str)
        .str.upper()
    )


# ============================================================
# KPI VALUES
# ============================================================

total_queries = len(query_df)

failed_queries = (
    int(
        query_df["STATUS"]
        .isin(["FAIL", "FAILED"])
        .sum()
    )
    if not query_df.empty
    else 0
)

slow_queries = (
    int(
        (
            query_df["TOTAL_ELAPSED_TIME"] >= 10000
        ).sum()
    )
    if not query_df.empty
    else 0
)

remote_spill_queries = (
    int(
        (
            query_df["BYTES_SPILLED_TO_REMOTE_STORAGE"] > 0
        ).sum()
    )
    if not query_df.empty
    else 0
)


# ============================================================
# HERO
# ============================================================

st.html("""
<div class="qa-hero">

    <div class="qa-label">
        WORKLOAD INTELLIGENCE
    </div>

    <div class="qa-title">
        Query Analysis
    </div>

    <div class="qa-description">
        Investigate expensive, slow and inefficient workloads
        using real Snowflake query telemetry.
    </div>

</div>
""")


# ============================================================
# KPI ROW
# ============================================================

k1, k2, k3, k4 = st.columns(4)

with k1:
    st.html(f"""
    <div class="qa-kpi">
        <div class="qa-kpi-label">QUERIES ANALYZED</div>
        <div class="qa-kpi-value">{total_queries:,}</div>
    </div>
    """)

with k2:
    st.html(f"""
    <div class="qa-kpi">
        <div class="qa-kpi-label">FAILED QUERIES</div>
        <div class="qa-kpi-value">{failed_queries:,}</div>
    </div>
    """)

with k3:
    st.html(f"""
    <div class="qa-kpi">
        <div class="qa-kpi-label">SLOW QUERIES</div>
        <div class="qa-kpi-value">{slow_queries:,}</div>
    </div>
    """)

with k4:
    st.html(f"""
    <div class="qa-kpi">
        <div class="qa-kpi-label">REMOTE SPILL</div>
        <div class="qa-kpi-value">{remote_spill_queries:,}</div>
    </div>
    """)


# ============================================================
# FILTERS
# ============================================================

st.html("""
<div class="qa-section-title">
    Investigation Filters
</div>

<div class="qa-section-description">
    Narrow the workload to the behavior you want to investigate.
</div>
""")


f1, f2, f3 = st.columns(3)


with f1:

    warehouses = ["All"]

    if not query_df.empty:

        warehouse_values = (
            query_df["WAREHOUSE_NAME"]
            .dropna()
            .astype(str)
            .unique()
            .tolist()
        )

        warehouses += sorted(warehouse_values)

    selected_warehouse = st.selectbox(
        "Warehouse",
        warehouses
    )


with f2:

    statuses = [
        "All",
        "SUCCESS",
        "FAIL"
    ]

    selected_status = st.selectbox(
        "Execution Status",
        statuses
    )


with f3:

    analysis_modes = [
        "Most Expensive",
        "Slowest Queries",
        "Remote Spill",
        "Poor Partition Pruning",
        "Low Cache Usage",
        "Failed Queries",
        "Most Frequent Patterns"
    ]

    selected_analysis = st.selectbox(
        "Analysis",
        analysis_modes
    )


# ============================================================
# APPLY FILTERS
# ============================================================

filtered = query_df.copy()


if selected_warehouse != "All":

    filtered = filtered[
        filtered["WAREHOUSE_NAME"]
        .astype(str)
        == selected_warehouse
    ]


if selected_status != "All":

    filtered = filtered[
        filtered["STATUS"]
        == selected_status
    ]


# ============================================================
# ANALYSIS MODE
# ============================================================

if selected_analysis == "Most Expensive":

    filtered = filtered.sort_values(
        "BYTES_SCANNED",
        ascending=False
    )

elif selected_analysis == "Slowest Queries":

    filtered = filtered.sort_values(
        "TOTAL_ELAPSED_TIME",
        ascending=False
    )

elif selected_analysis == "Remote Spill":

    filtered = filtered[
        filtered["BYTES_SPILLED_TO_REMOTE_STORAGE"] > 0
    ].sort_values(
        "BYTES_SPILLED_TO_REMOTE_STORAGE",
        ascending=False
    )

elif selected_analysis == "Poor Partition Pruning":

    filtered = filtered[
        filtered["PARTITION_SCAN_PCT"] > 50
    ].sort_values(
        "PARTITION_SCAN_PCT",
        ascending=False
    )

elif selected_analysis == "Low Cache Usage":

    filtered = filtered[
        filtered["PERCENTAGE_SCANNED_FROM_CACHE"] < 20
    ].sort_values(
        "PERCENTAGE_SCANNED_FROM_CACHE",
        ascending=True
    )

elif selected_analysis == "Failed Queries":

    filtered = filtered[
        filtered["STATUS"].isin(
            ["FAIL", "FAILED"]
        )
    ].sort_values(
        "START_TIME",
        ascending=False
    )

elif selected_analysis == "Most Frequent Patterns":

    pattern_counts = (
        filtered
        .groupby(
            "QUERY_PARAMETERIZED_HASH",
            dropna=False
        )
        .size()
        .reset_index(name="EXECUTION_COUNT")
        .sort_values(
            "EXECUTION_COUNT",
            ascending=False
        )
        .head(25)
    )

    st.html("""
    <div class="qa-section-title">
        Repeated Query Patterns
    </div>

    <div class="qa-section-description">
        Parameterized query patterns with the highest execution frequency.
    </div>
    """)

    if pattern_counts.empty:

        st.info(
            "No repeated query patterns were found."
        )

    else:

        st.dataframe(
            pattern_counts,
            width="stretch",
            hide_index=True
        )

    filtered = filtered.sort_values(
        "START_TIME",
        ascending=False
    )


# ============================================================
# QUERY TABLE
# ============================================================

st.html("""
<div class="qa-section-title">
    Query Investigation
</div>

<div class="qa-section-description">
    Select a query from the table to inspect its execution behavior.
</div>
""")


if filtered.empty:

    st.info(
        "No queries match the selected investigation filters."
    )

else:

    display_df = filtered.head(100).copy()

    display_df["Runtime"] = (
        display_df["TOTAL_ELAPSED_TIME"]
        .map(format_runtime)
    )

    display_df["Scanned"] = (
        display_df["BYTES_SCANNED"]
        .map(format_bytes)
    )

    display_df["Cache %"] = (
        display_df["PERCENTAGE_SCANNED_FROM_CACHE"]
        .map(lambda x: f"{float(x):.1f}%")
    )

    display_df["Partition Scan %"] = (
        display_df["PARTITION_SCAN_PCT"]
        .map(lambda x: f"{float(x):.1f}%")
    )

    display_df["Local Spill"] = (
        display_df["BYTES_SPILLED_TO_LOCAL_STORAGE"]
        .map(format_bytes)
    )

    display_df["Remote Spill"] = (
        display_df["BYTES_SPILLED_TO_REMOTE_STORAGE"]
        .map(format_bytes)
    )

    display_df["Started"] = (
        display_df["START_TIME"]
        .dt.strftime("%d %b %Y %H:%M:%S")
    )

    table_df = display_df[
        [
            "QUERY_ID",
            "WAREHOUSE_NAME",
            "STATUS",
            "Runtime",
            "Scanned",
            "Cache %",
            "Partition Scan %",
            "Local Spill",
            "Remote Spill",
            "Started"
        ]
    ].copy()

    table_df.columns = [
        "Query ID",
        "Warehouse",
        "Status",
        "Runtime",
        "Scanned",
        "Cache %",
        "Partition Scan %",
        "Local Spill",
        "Remote Spill",
        "Started"
    ]

    st.dataframe(
        table_df,
        width="stretch",
        hide_index=True,
        height=430
    )


# ============================================================
# QUERY DETAIL
# ============================================================

st.html("""
<div class="qa-section-title">
    Query Detail
</div>

<div class="qa-section-description">
    Inspect the execution profile and SQL text for a selected query.
</div>
""")


if not filtered.empty:

    query_options = filtered[
        "QUERY_ID"
    ].dropna().astype(str).tolist()

    if query_options:

        selected_query_id = st.selectbox(
            "Select Query",
            query_options,
            key="query_detail_selector"
        )

        selected = filtered[
            filtered["QUERY_ID"].astype(str)
            == selected_query_id
        ]

        if not selected.empty:

            row = selected.iloc[0]

            st.html(f"""
            <div class="query-box">

                <div class="query-id">
                    QUERY ID • {row["QUERY_ID"]}
                </div>

                <div class="query-text">
                    {str(row["QUERY_TEXT"] or "SQL text unavailable")}
                </div>

            </div>
            """)

            st.markdown("")

            d1, d2, d3, d4 = st.columns(4)

            with d1:
                st.metric(
                    "Runtime",
                    format_runtime(
                        row["TOTAL_ELAPSED_TIME"]
                    )
                )

            with d2:
                st.metric(
                    "Data Scanned",
                    format_bytes(
                        row["BYTES_SCANNED"]
                    )
                )

            with d3:
                st.metric(
                    "Cache Usage",
                    f'{float(row["PERCENTAGE_SCANNED_FROM_CACHE"]):.1f}%'
                )

            with d4:
                st.metric(
                    "Partition Scan",
                    f'{float(row["PARTITION_SCAN_PCT"]):.1f}%'
                )

            st.markdown("")

            s1, s2, s3 = st.columns(3)

            with s1:

                st.html(f"""
                <div class="signal">
                    <div class="signal-title">
                        Execution Status
                    </div>

                    <div class="signal-value">
                        {row["STATUS"]}
                    </div>
                </div>
                """)

            with s2:

                st.html(f"""
                <div class="signal">
                    <div class="signal-title">
                        Warehouse
                    </div>

                    <div class="signal-value">
                        {row["WAREHOUSE_NAME"]}
                    </div>
                </div>
                """)

            with s3:

                st.html(f"""
                <div class="signal">
                    <div class="signal-title">
                        Remote Spill
                    </div>

                    <div class="signal-value">
                        {format_bytes(row["BYTES_SPILLED_TO_REMOTE_STORAGE"])}
                    </div>
                </div>
                """)

else:

    st.info(
        "Select a query to inspect its details."
    )


# ============================================================
# FOOTER
# ============================================================

st.caption(
    "Snowflake FinOps Control Center • "
    "Query analysis is based on available Snowflake query telemetry."
)
